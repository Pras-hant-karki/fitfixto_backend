# ============================================================
# FitFIXto Backend — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URL=mongodb://localhost:27017
DB_NAME=FitFixto

# JWT / Tokens
# Generate strong secrets: openssl rand -base64 64
ACCESS_TOKEN_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRY=20d
REFRESH_TOKEN_EXPIRY=20d

# Email (Gmail App Password — see https://support.google.com/accounts/answer/185833)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
# Get webhook secret from: stripe listen --forward-to localhost:5000/api/v1/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Google Maps (server-side)
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY

# Scheduled jobs
# Generate: openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# File uploads
UPLOAD_DIR=./public/assets
MAX_FILE_SIZE=10485760

# Admin seed account (used by seed script only)
ADMIN_EMAIL=admin@fitfixto.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
